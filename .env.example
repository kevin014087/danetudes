# Configuration DANETUDES - Node.js
# Copiez ce fichier en .env et remplissez les valeurs

# Email
RECIPIENT_EMAIL=dkouassi0805@gmail.com
RECIPIENT_NAME=DANETUDES
SITE_NAME=DANETUDES

# Configuration SMTP (pour l'envoi d'emails)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=votre_username
SMTP_PASS=votre_password

# Sécurité
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=3600
ALLOWED_ORIGINS=https://danetudes.ci,http://localhost:3000

# Site
SITE_URL=https://danetudes.ci
SITE_DESCRIPTION=DANETUDES - Formation et cours en ligne en Côte d'Ivoire

# Langues actives
LANGUAGES=fr,en
DEFAULT_LANGUAGE=fr

# Mode
DEBUG_MODE=false
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
